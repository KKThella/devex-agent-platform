# Anthropic API
ANTHROPIC_API_KEY=

# App config
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO

# ChromaDB (local by default, swap for hosted in prod)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=devex_knowledge

# Observability
METRICS_ENABLED=true
METRICS_FLUSH_INTERVAL=60    # seconds
